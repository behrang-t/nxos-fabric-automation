{% for probe in collection_results_payload.traffic_probes %}
| `{{ probe.probe_id }}` | {{ probe.category }} | `{{ probe.source }}` | `{{ probe.source_interface }}` | `{{ probe.destination }}` | {{ probe.execution_status }} | {{ probe.return_code if probe.return_code is not none else 'n/a' }} | {% if probe.raw_file %}`{{ probe.raw_file }}`{% else %}not written{% endif %} |
