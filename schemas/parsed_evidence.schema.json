{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "engine_version", "run_id", "generated_at", "source", "parser_package", "status", "summary", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "engine_version": {"type": "string"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "source": {"type": "object", "required": ["file", "sha256"], "properties": {"file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "parser_package": {"type": "object", "required": ["version", "commit", "editable"], "properties": {"version": {"type": "string"}, "commit": {"type": ["string", "null"]}, "editable": {"type": "boolean"}}},
    "status": {"enum": ["complete", "partial"]},
    "summary": {"type": "object", "required": ["records", "counts"], "properties": {"records": {"type": "integer", "minimum": 0}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["record_id", "phase", "device", "role", "command", "category", "probe_id", "raw_file", "collection_status", "collection_message", "parsing_status", "parser", "data", "error"],
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string"},
        "phase": {"enum": ["baseline", "post_probe", "configuration_snapshots", "traffic_probes"]},
        "device": {"type": "string"},
        "role": {"type": ["string", "null"]},
        "command": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "probe_id": {"type": ["string", "null"]},
        "raw_file": {"type": ["string", "null"]},
        "collection_status": {"enum": ["completed", "collected", "error"]},
        "collection_message": {"type": "string"},
        "parsing_status": {"enum": ["parsed", "empty", "skipped_collection_error", "invalid_input", "not_applicable", "parser_not_found", "parse_error"]},
        "parser": {"type": ["object", "null"], "required": ["class", "module", "command"], "properties": {"class": {"type": "string"}, "module": {"type": "string"}, "command": {"type": ["string", "null"]}}},
        "data": {"type": ["object", "null"]},
        "error": {"type": ["object", "null"], "required": ["type", "message"], "properties": {"type": {"type": "string"}, "message": {"type": "string"}}},
        "measurement": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"parsing_status": {"enum": ["parsed", "empty"]}}}, "then": {"properties": {"data": {"type": "object"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}}}}
      ]
    }
  }
}
